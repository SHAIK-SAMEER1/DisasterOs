# DisasterOS Environment Configuration
# Copy this file to .env and fill in real values when deploying to Supabase / Production.
# NEVER commit real service keys, database passwords, or API secrets to git.

# Supabase PostgreSQL Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Telemetry Cache TTL (in milliseconds)
VITE_WEATHER_CACHE_TTL_MS=300000
VITE_SEISMIC_CACHE_TTL_MS=60000

# Geographic Defaults
VITE_DEFAULT_CITY=Chennai
VITE_DEFAULT_LAT=13.0827
VITE_DEFAULT_LON=80.2707

# Optional LLM Provider Key (Server-side use only)
# GEMINI_API_KEY=
