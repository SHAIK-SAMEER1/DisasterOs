' =========================================================================
' 1. COMPLETE UML USE CASE DIAGRAM (PlantUML)
' =========================================================================
@startuml DisasterOS_UseCase_Diagram
skinparam packageStyle rectangle
skinparam roundCorner 10
skinparam shadowing true
skinparam handwritten false
skinparam actorStyle awesome
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam usecase {
    BackgroundColor #10243a
    BorderColor #35a7ff
    FontColor #e9f1fa
    ArrowColor #35a7ff
}

skinparam actor {
    BackgroundColor #1976d2
    BorderColor #64c5ff
    FontColor #111827
}

skinparam rectangle {
    BackgroundColor #081421
    BorderColor #233b57
    FontColor #64c5ff
}

' --- ACTORS ---
actor "Citizen" as Citizen
actor "Emergency Responder" as Responder
actor "Volunteer" as Volunteer
actor "Warehouse Manager" as WarehouseMgr

actor "Disaster Manager" as Manager
actor "Hospital Coordinator" as HospitalCoord
actor "NGO Coordinator" as NGOCoord
actor "System Administrator" as Admin

actor "External Weather & Seismic APIs" as ExtAPIs << System >>
actor "AI LLM Services" as AIService << System >>
actor "SMS / Siren Gateway" as SirenGateway << System >>

' --- SYSTEM BOUNDARY ---
rectangle "DisasterOS Enterprise Command & Relief Platform" {

    ' Citizen Subsystem
    package "Citizen Services & Intake" {
        usecase "UC1: Report Incident with Native GPS" as UC1
        usecase "UC2: Request Emergency Help (Rescue/Med)" as UC2
        usecase "UC3: View Live GIS Risk Map & Shelters" as UC3
        usecase "UC4: Receive Early Warning Broadcasts" as UC4
        usecase "UC5: Query AI Emergency Assistant" as UC5
        usecase "UC6: Access Turn-by-Turn Evacuation Route" as UC6
    }

    ' Field Operations Subsystem
    package "Tactical Field Response" {
        usecase "UC7: Accept & Acknowledge Rescue Dispatch" as UC7
        usecase "UC8: Update Incident Lifecycle State" as UC8
        usecase "UC9: Transmit Field Casualty Triage Data" as UC9
    }

    ' Logistics & Human Resources Subsystem
    package "Logistics, Shelter & Volunteer Coordination" {
        usecase "UC10: Register Volunteer Skills & Zones" as UC10
        usecase "UC11: Track Warehouse Stock & Ration Issuance" as UC11
        usecase "UC12: Manage Shelter Capacity & Headroom" as UC12
        usecase "UC13: Coordinate Emergency Patient Transfers" as UC13
        usecase "UC14: Update Hospital Bed & ICU Capacity" as UC14
    }

    ' Command & Intelligence Subsystem
    package "Command Intelligence & Decision Support" {
        usecase "UC15: Ingest & Normalize Sensor Feeds" as UC15
        usecase "UC16: Compute Composite R_zone Risk Index" as UC16
        usecase "UC17: Configure Alert Rules & Thresholds" as UC17
        usecase "UC18: Execute Automated SOP Workflows" as UC18
        usecase "UC19: Run Heuristic Dispatch Priority Queue" as UC19
        usecase "UC20: Authorize & Broadcast Evacuation Orders" as UC20
        usecase "UC21: Generate AI Situation Reports" as UC21
        usecase "UC22: Analyze Operational Response Trends" as UC22
    }

    ' Governance Subsystem
    package "Governance & Administration" {
        usecase "UC23: Manage Role-Based Access Matrix (RBAC)" as UC23
        usecase "UC24: Inspect Chronological Audit Trails" as UC24
    }
}

' --- RELATIONSHIPS: CITIZEN & FIELD ---
Citizen --> UC1
Citizen --> UC2
Citizen --> UC3
Citizen --> UC4
Citizen --> UC5
Citizen --> UC6

Responder --> UC7
Responder --> UC8
Responder --> UC9
Responder --> UC3
Responder --> UC6

Volunteer --> UC10
WarehouseMgr --> UC11

' --- RELATIONSHIPS: COMMAND & SPECIALISTS ---
Manager --> UC15
Manager --> UC16
Manager --> UC17
Manager --> UC18
Manager --> UC19
Manager --> UC20
Manager --> UC21
Manager --> UC22
Manager --> UC12
Manager --> UC24

HospitalCoord --> UC14
HospitalCoord --> UC13
HospitalCoord --> UC9

NGOCoord --> UC10
NGOCoord --> UC12
NGOCoord --> UC22

Admin --> UC23
Admin --> UC24

' --- RELATIONSHIPS: SYSTEM ACTORS ---
ExtAPIs --> UC15
ExtAPIs --> UC16
AIService --> UC5
AIService --> UC21
SirenGateway <-- UC20
SirenGateway <-- UC4

' --- INCLUDE & EXTEND DEPENDENCIES ---
UC2 ..> UC1 : <<include>>
UC18 ..> UC19 : <<include>>
UC20 ..> UC16 : <<extend>>
UC21 ..> UC22 : <<include>>
UC7 ..> UC8 : <<include>>

@enduml



' =========================================================================
' 2. COMPLETE UML COMPONENT DIAGRAM (PlantUML)
' =========================================================================
@startuml DisasterOS_Component_Diagram
skinparam componentStyle uml2
skinparam roundCorner 8
skinparam shadowing true
skinparam defaultFontName Arial

skinparam component {
    BackgroundColor #101f33
    BorderColor #35a7ff
    FontColor #e9f1fa
    ArrowColor #37d7e8
}

skinparam interface {
    BackgroundColor #35d49a
    BorderColor #147c5e
}

skinparam package {
    BackgroundColor #081421
    BorderColor #233b57
    FontColor #64c5ff
}

package "Presentation & Client Tier" {
    [Citizen Mobile / Web Portal] as CitizenUI
    [Command Center Dashboard (25 Modules)] as CommandUI
    [Leaflet GIS Map Engine] as GISMap
    [AI Tactical Assistant Chatbot] as ChatWidget
}

package "Ingestion & API Gateway Tier" {
    [Ingestion Gateway\n(gateway.js)] as Gateway
    interface "IIngestion" as IIngest
    interface "IWeatherFeed" as IWeather
    interface "ISeismicFeed" as ISeismic
    Gateway -up-> IIngest
}

package "External Scientific & Cloud Services" {
    [Open-Meteo Weather API] as OpenMeteo
    [USGS Earthquake Feed] as USGSFeed
    [OpenStreetMap Tile Server] as OSMTiles
    [SMS / Push Broadcast Gateway] as PushBroker
    [Cloud AI Inference (Gemini/Claude)] as AICloud
}

package "Core Intelligence & Business Logic Tier" {
    [Risk Calculation Engine\n(risk-engine.js)] as RiskEngine
    [Decision Support & SOP Automation] as DecisionSOP
    [Dispatch & Triage Optimizer] as TriageEngine
    [AI Situation Report Synthesizer] as AISynth
    
    interface "IRiskEngine" as IRisk
    interface "IDecisionSOP" as ISOP
    interface "IAIReport" as IReport

    RiskEngine -up-> IRisk
    DecisionSOP -up-> ISOP
    AISynth -up-> IReport
}

package "Operations & Application Tier" {
    [App Orchestrator (app.js)] as AppOrchestrator
    [Incident Lifecycle Service] as IncidentService
    [Shelter & Resource Manager] as ShelterService
    [Hospital & Triage Coordinator] as HospitalService
}

package "Data Access & Persistence Tier" {
    [Data Access Layer (store.js)] as DAL
    interface "IDataStore" as IStore
    DAL -up-> IStore

    database "Client Cache (IndexedDB / LocalStore)" as LocalCache
    database "Target Cloud PostgreSQL (Supabase)" as CloudDB
}

' --- PRESENTATION WIRING ---
CitizenUI ..> IIngest : HTTP POST Incident
CitizenUI ..> AppOrchestrator : State Sync
CommandUI ..> AppOrchestrator : Route Actions
CommandUI ..> GISMap : Embed Viewport
ChatWidget ..> AppOrchestrator : Query Chat

GISMap ..> OSMTiles : HTTP Tile Request
GISMap ..> IStore : Read Spatial Markers

' --- INGESTION WIRING ---
Gateway ..> OpenMeteo : Live Rainfall (5-min TTL)
Gateway ..> USGSFeed : GeoJSON Quakes (1-min TTL)

' --- LOGIC WIRING ---
RiskEngine ..> IIngest : Ingest Normalized Readings
DecisionSOP ..> IRisk : Query Zone R_zone Scores
DecisionSOP ..> TriageEngine : Compute Priority Queue
DecisionSOP ..> PushBroker : Trigger Public Siren

AppOrchestrator ..> ISOP : Trigger Manual SOP
AppOrchestrator ..> IReport : Generate Briefing
AppOrchestrator ..> IncidentService : Transition Incidents
AppOrchestrator ..> ShelterService : Update Bed Allocations
AppOrchestrator ..> HospitalService : Reserve Trauma Units

AISynth ..> AICloud : Inference Prompt
AISynth ..> IStore : Aggregate Telemetry

' --- DATA WIRING ---
IncidentService ..> IStore : Write Incident
ShelterService ..> IStore : Update Headroom
HospitalService ..> IStore : Update Beds
RiskEngine ..> IStore : Persist R_zone History

DAL ..> LocalCache : Read / Write (Offline-First)
DAL ..> CloudDB : Replicate Relational Schemas (Review 2/3)

@enduml



' =========================================================================
' 3. COMPLETE UML SEQUENCE DIAGRAM (PlantUML)
' =========================================================================
@startuml DisasterOS_Sequence_Diagram
autonumber
skinparam roundCorner 8
skinparam shadowing true
skinparam defaultFontName Arial
skinparam ParticipantPadding 15
skinparam BoxPadding 10

skinparam sequence {
    ArrowColor #35a7ff
    LifeLineBorderColor #35a7ff
    LifeLineBackgroundColor #10243a
    ParticipantBackgroundColor #1976d2
    ParticipantBorderColor #64c5ff
    ParticipantFontColor #ffffff
    ActorBackgroundColor #35d49a
    ActorBorderColor #147c5e
}

box "Citizens & Field Units" #081421
actor "Citizen" as Citizen
actor "Rescue Team" as Responder
actor "Hospital Coordinator" as HospitalCoord
actor "Shelter Manager" as ShelterMgr
end box

box "Frontend & Ingestion Layer" #0b1b2c
participant "CitizenUI" as UI
participant "IngestionGateway" as Gateway
end box

box "Core Intelligence & Logic" #10243a
participant "RiskEngine" as Risk
participant "DecisionSOP" as SOP
participant "AIReporter" as AI
end box

box "Data & Persistence" #14263d
participant "DAL (store.js)" as DAL
database "Database (Store/PostgreSQL)" as DB
end box

' --- 1. INCIDENT REPORTING ---
Citizen -> UI: 1. Submit emergency incident (type, media)
activate UI
UI -> UI: 2. Capture native GPS (navigator.geolocation)
UI -> Gateway: 3. POST /incidents (lat, lon, severity, description)
activate Gateway

Gateway -> DAL: 4. insertIncident(status="reported")
activate DAL
DAL -> DB: 5. INSERT into Incidents (UUID, coordinates)
DAL --> Gateway: 6. Acknowledge (incident_id="INC-1005")
deactivate DAL

' --- 2. LIVE TELEMETRY INGESTION ---
Gateway -> Gateway: 7. Poll Open-Meteo & USGS feeds for zone coordinates
Gateway -> Risk: 8. evaluateZone(zone_id, rainfall_3h, max_mag)
activate Risk

' --- 3. RISK CALCULATION ---
Risk -> Risk: 9. Compute composite R_zone formula\n(w1*Rain + w2*Seismic + w3*Vuln - w4*ShelterHeadroom)
Risk -> DAL: 10. updateZoneRiskScore(zone_id, R_zone=0.84)
activate DAL
DAL -> DB: 11. UPDATE Zones SET current_r_zone=0.84
deactivate DAL

alt R_zone >= 0.80 (CRITICAL EMERGENCY)
    Risk -> SOP: 12. triggerSOP("CRITICAL_FLOOD_EVACUATION")
    activate SOP
    
    ' --- 4. DECISION SUPPORT & TRIAGE ---
    SOP -> DAL: 13. createEmergencyRequest(autoDerived=true)
    SOP -> SOP: 14. prioritizeQueue (Score = 0.5*Urgency + 0.35*R_zone + 0.15*Load)
    
    ' --- 5. TACTICAL DISPATCH & MEDICAL RESERVATION ---
    SOP -> Responder: 15. dispatchTacticalAlert(INC-1005, turn-by-turn route)
    activate Responder
    Responder -> DAL: 16. acknowledgeDispatch(status="en_route", eta="8 min")
    deactivate Responder

    SOP -> HospitalCoord: 17. transmitMassCasualtyAlert(reserve ICU beds)
    activate HospitalCoord
    HospitalCoord -> DAL: 18. updateAvailableBeds(reservedCount=5)
    deactivate HospitalCoord

    SOP -> ShelterMgr: 19. verifyShelterCapacity(prepare admissions)
    activate ShelterMgr
    ShelterMgr -> DAL: 20. logAdmissions(headroomRemaining=118)
    deactivate ShelterMgr

    ' --- 6. AI SITUATION SYNTHESIS ---
    SOP -> AI: 21. synthesizeSituationReport()
    activate AI
    AI -> DAL: 22. recordReport(executiveSummary, auditToken)
    deactivate AI

    SOP -> DAL: 23. writeAuditLog("SOP_CRITICAL_EXECUTED")
    deactivate SOP

else R_zone < 0.80 (Advisory / Watch)
    Risk -> DAL: Log baseline telemetry (no immediate dispatch)
end
deactivate Risk

' --- 7. CITIZEN HUD FEEDBACK ---
DAL --> Gateway: 24. Return updated incident & dispatch status
deactivate Gateway
Gateway --> UI: 25. Push status update ("DISPATCHED", TeamAlpha, SafeShelterRoute)
UI --> Citizen: 26. Display interactive emergency tracking HUD & Evacuation Route
deactivate UI

@enduml
